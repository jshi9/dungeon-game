# Retro 3D Dungeon - AI Scriptorium Configuration
# Copy this file to .env and insert your API key for real-time generative books.

# Google Gemini (Default - Recommended: gemini-1.5-flash)
VITE_GEMINI_API_KEY=
VITE_AI_PROVIDER=gemini
VITE_AI_MODEL=gemini-1.5-flash

# OpenAI / Compatible Provider (Alternative)
# VITE_OPENAI_API_KEY=
# VITE_AI_PROVIDER=openai
# VITE_AI_MODEL=gpt-4o-mini

# Groq (Alternative)
# VITE_GROQ_API_KEY=
# VITE_AI_PROVIDER=groq
# VITE_AI_MODEL=llama-3.1-8b-instant

# Custom AI Proxy or Backend Endpoint
# VITE_AI_ENDPOINT=https://your-custom-proxy.com/v1/generate
